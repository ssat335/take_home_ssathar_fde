# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Bedrock region — must match the inference profile's geo prefix (e.g. "us.")
AWS_REGION=us-west-2

# Confirm availability first: aws bedrock list-inference-profiles --region <region>
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Generation params for the query agent
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=2048

# Local dev credentials (one of): a Bedrock API key, or leave unset to use
# a configured AWS profile / IAM role.
# AWS_BEARER_TOKEN_BEDROCK=
